# Official CPython 3.12.13 Debian image, verified linux/amd64 manifest.
ARG PYTHON_BASE=python:3.12.13-slim-bookworm@sha256:6e13e65c55e33adf203d77ee371cf8bf5d81bd4902ef07565721f46bf44917af
FROM ${PYTHON_BASE} AS native_builder
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake ninja-build && rm -rf /var/lib/apt/lists/*
COPY frozen_model/CMakeLists.txt /source/CMakeLists.txt
COPY frozen_model/src /source/src
COPY frozen_model/extern /source/extern
COPY build_native_record.py /build_native_record.py
RUN python /build_native_record.py /source /build /candidate

FROM ${PYTHON_BASE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements-runtime-container.txt /requirements-runtime-container.txt
RUN python -m pip install --no-cache-dir --only-binary=:all: -r /requirements-runtime-container.txt
COPY --from=native_builder /candidate /opt/fishsim-native
RUN python -m pip freeze > /opt/fishsim-native/INSTALLED_PACKAGES.txt
RUN PYTHONPATH=/opt/fishsim-native python -c 'import cmodel,json,platform; print(json.dumps(dict(status="native_import_passed",python_version=platform.python_version(),module=cmodel.__file__,native_steps=0,scope="Import only; no simulation or portability claim beyond this image")))' > /opt/fishsim-native/NATIVE_IMPORT.json
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 MPLCONFIGDIR=/tmp/fishsim-matplotlib
WORKDIR /workspace
CMD ["python", "--version"]

FROM runtime AS current_model_validation
COPY validation /validation
RUN --network=none python /validation/run_container_validation.py

FROM scratch AS validation_receipt
COPY --from=current_model_validation /validation/export /
