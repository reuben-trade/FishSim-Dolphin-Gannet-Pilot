def test_rejected_preparation_cannot_be_used_as_zero_or_replaced(monkeypatch,tmp_path):
    import evidence
    folder=tmp_path/'preparation';folder.mkdir()
    checkpoints={str(s):dict(sha256='fake',path='unused',accepted=s!=SEEDS[2]) for s in SEEDS}
    candidates=[dict(school_seed=s,accepted=s!=SEEDS[2],checkpoint=dict(sha256='fake')) for s in SEEDS]
    manifest=dict(status='complete',checkpoints=checkpoints,candidates=candidates,total_native_steps=588800)
    def read_fake(path):
        if Path(path).name=='manifest.json':return manifest
        return next(r for r in candidates if 's'+str(r['school_seed'])==Path(path).parent.name)
    monkeypatch.setattr(evidence,'PREP_OUTPUT',folder)
    monkeypatch.setattr(evidence,'read',read_fake)
    monkeypatch.setattr(evidence,'validate_seal',lambda path:dict(files={}))
    monkeypatch.setattr(evidence,'sha',lambda path:'fake')
    with pytest.raises(RuntimeError,match='Rejected candidate retained'):
        evidence.preparation_manifest()
