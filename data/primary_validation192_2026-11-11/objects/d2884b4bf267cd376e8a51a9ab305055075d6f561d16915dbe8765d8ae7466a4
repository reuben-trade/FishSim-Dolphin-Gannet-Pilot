def test_fixed_forty_cases_and_completion_barriers():
    cells=all_cases()
    assert len(cells)==len({c.name for c in cells})==40
    assert set(c.school_seed for c in cells)==set(range(39065501,39065509))
    assert {c.capture_seed for c in cells}=={61001}
    assert {c.herding_minimum for c in cells if c.dolphins}=={1.}
    assert {c.gannets for c in cells if c.gannets}=={6}
    stages=execution_stages()
    assert [len(v) for _,v in stages]==[16,8,16]
    assert all(c.presence=='D' for c in stages[0][1])
    assert all(c.presence=='G' and c.grid=='fine' for c in stages[1][1])
    assert all(c.presence=='DG' for c in stages[2][1])
    assert tuple(c for _,group in stages for c in group)!=cells
    assert set(c for _,group in stages for c in group)==set(cells)


