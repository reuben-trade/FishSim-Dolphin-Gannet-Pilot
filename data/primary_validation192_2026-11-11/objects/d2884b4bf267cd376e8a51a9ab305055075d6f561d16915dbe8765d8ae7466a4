def test_repeat_analysis_keeps_eight_school_units_and_primary_unchanged():
    from analyze_repeat import repeat_statistics
    from repeat_cases import all_repeat_cases
    primary=synthetic_rows();before=json.dumps(primary,sort_keys=True)
    repeated=[]
    primary_fine={(r['school_seed'],r['presence']):r for r in primary if r['grid']=='fine'}
    for c in all_repeat_cases():
        old=primary_fine[c.school_seed,c.presence]
        repeated.append(dict(c.asdict(),D_captures=old['D_captures']+(2 if c.presence=='DG' else 0),
            G_captures=old['G_captures']-(1 if c.presence=='DG' else 0)))
    settings=json.loads((HERE/'repeat_analysis_plan.json').read_text())['bootstrap']
    pairs,summary=repeat_statistics(primary,repeated,settings)
    assert len(pairs)==8 and all(r['independent_schools']==8 for r in summary)
    assert all(p['repeat_minus_primary_D_change']==2 and p['repeat_minus_primary_G_change']==-1 for p in pairs)
    assert summary[2]['mean_rate_change']==pytest.approx(2/432)
    assert summary[2]['pointwise95_low']==pytest.approx(2/432)
    assert summary[2]['pointwise95_high']==pytest.approx(2/432)
    assert summary[3]['mean_rate_change']==pytest.approx(-1/216)
    assert json.dumps(primary,sort_keys=True)==before
    with pytest.raises(ValueError):repeat_statistics(primary,repeated[:-1],settings)


