def test_step_budgets_and_fresh_smokes():
    assert sum(round(36/c.dt) for c in all_cases())==FEEDING_STEPS==1843200
    assert sum(round(4/c.dt) for c in smoke_cases())==SMOKE_STEPS==25600
    assert PREP_STEPS==8*round(92/.00125)==588800
    assert PREP_STEPS+FEEDING_STEPS+SMOKE_STEPS==2457600
    assert SMOKE_RESERVE==32000 and CONSERVATIVE_TOTAL_CAP==2924800
    assert [(c.grid,c.presence) for c in smoke_cases()]==[
        ('fine','D'),('coarse','D'),('fine','G'),('fine','DG'),('coarse','DG')]


@pytest.mark.parametrize('dt',[.00125,.000625])
def test_physical_cadences_do_not_change_with_grid(dt):
    steps=round(4/dt)
    sampled=[i*dt for i in range(steps+1) if sample_due(i,steps,dt)]
    progressed=[i*dt for i in range(steps+1) if progress_due(i,steps,dt)]
    assert np.allclose(sampled,np.arange(41)*.1,rtol=0,atol=1e-14)
    assert progressed==[0.,1.,2.,3.,4.]


def state(finite=True):
    positions=np.zeros((160,3));positions[:,2]=-3.
    if not finite:positions[0,0]=np.nan
    return SimpleNamespace(positions=positions,prey_ids=np.arange(160))


def samples(original_speed=3.,additional_speed=3.):
    rows=[]
    for t in np.arange(20,92.01,.5):
        x=(min(t,56)-20)*original_speed+max(0,t-56)*additional_speed
        rows.append(dict(time=float(t),centroid_x=float(x),largest_component_fraction=1.))
    return rows


def test_original_pass_additional_fail_does_not_reject():
    original,extra,_=prepare.screen_checks(samples(additional_speed=0),state(),state(False),3.)
    assert original['passed'] is True and extra['passed'] is False


def test_original_fail_additional_pass_does_not_accept():
    original,extra,_=prepare.screen_checks(samples(original_speed=0),state(False),state(),3.)
    assert original['passed'] is False and extra['passed'] is True


def test_original_connectivity_is_still_an_inclusion_requirement():
    rows=samples()
    for r in rows:
        if r['time']<56:r['largest_component_fraction']=.5
    original,extra,_=prepare.screen_checks(rows,state(),state(),3.)
    assert not original['passed'] and extra['passed']


