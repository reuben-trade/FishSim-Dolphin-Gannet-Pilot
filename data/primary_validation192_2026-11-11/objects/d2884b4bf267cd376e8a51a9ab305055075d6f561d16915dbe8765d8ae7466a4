def synthetic_rows():
    rows=[]
    for case in all_cases():
        i=case.school_seed-SEEDS[0]
        d=20+(i-3 if case.grid=='fine' else 2-i) if case.presence=='DG' else 20 if case.presence=='D' else 0
        g=5+(2-i) if case.presence=='DG' else 5 if case.presence=='G' else 0
        rows.append(dict(case.asdict(),D_captures=d,G_captures=g))
    return rows


def test_whole_school_species_and_grid_bootstrap_matches_weight_matrix():
    from analyze import paired_statistics
    settings=json.loads((HERE/'analysis_plan.json').read_text())['bootstrap']
    pairs,summary=paired_statistics(synthetic_rows(),settings)
    values=np.asarray([[p[k] for k in ('fine_D_rate_change','fine_G_rate_change',
        'coarse_D_rate_change','fine_minus_coarse_D_rate_change')] for p in pairs])
    index=np.random.default_rng(88495509).integers(0,8,size=(10000,8))
    weights=np.zeros((10000,8),dtype=int)
    for i in range(8):weights[:,i]=(index==i).sum(axis=1)
    expected=np.quantile(weights@values/8,[.025,.975],axis=0)
    for j,row in enumerate(summary):
        assert row['independent_schools']==8
        assert row['mean_rate_change']==pytest.approx(values[:,j].mean(),abs=1e-15)
        assert [row['pointwise95_low'],row['pointwise95_high']]==pytest.approx(expected[:,j],abs=1e-15)
    assert np.allclose(values[:,3],values[:,0]-values[:,2],rtol=0,atol=1e-16)


@pytest.mark.parametrize('change',['missing','duplicate'])
def test_analysis_refuses_incomplete_or_duplicate_case_set(change):
    from analyze import paired_statistics
    rows=synthetic_rows()
    if change=='missing':rows.pop()
    else:rows[-1]=rows[0]
    with pytest.raises(ValueError):paired_statistics(rows,dict(seed=88495509,draws=10000,quantiles=[.025,.975]))


@pytest.mark.parametrize('depleted,observed,exposure,recent,expected',[
    (False,35.99999999996726,0.,0.,(36.,36.)),
    (False,35.99999999996726,4.,7.,(29.,32.)),
    (True,12.,4.,7.,(5.,8.)),(True,.05,.1,.1,(0.,0.))])
def test_actual_summary_complementary_clock_block(depleted,observed,exposure,recent,expected):
    tree=ast.parse((HERE/'run.py').read_text())
    block=next(n for n in ast.walk(tree) if isinstance(n,ast.For)
        and isinstance(n.target,ast.Tuple) and [getattr(e,'id','') for e in n.target.elts]==['who','row']
        and isinstance(n.iter,ast.Call) and isinstance(n.iter.func,ast.Attribute)
        and isinstance(n.iter.func.value,ast.Name) and n.iter.func.value.id=='per')
    env=dict(per={'D00':{}},semantic_time={'D00':{}},available={'D00':0.},
        exposure={'D00':exposure},with_recent_event={'D00':recent},duration=36.,
        observed_duration=observed,depletion_elapsed=observed if depleted else None)
    exec(compile(ast.Module(body=[block],type_ignores=[]),str(HERE/'run.py'),'exec'),env)
    row=env['per']['D00']
    assert (row['sampled_no_recent_gannet_event_T'],row['sampled_no_opportunity_T'])==expected


