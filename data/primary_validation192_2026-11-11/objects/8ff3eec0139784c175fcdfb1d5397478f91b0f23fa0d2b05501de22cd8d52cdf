STATE_FIELDS = ('positions', 'directions', 'prey_ids', 'time', 'step_index', 'surface_reflections')


def read(path):
    return json.loads(Path(path).read_text())


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def records(path):
    with gzip.open(path, 'rt') as handle:
        return [json.loads(line) for line in handle]


def csv_rows(path):
    with Path(path).open(newline='') as handle:
        return list(csv.DictReader(handle))


def close(a, b):
    assert np.isfinite(float(a)) and np.isfinite(float(b))
    assert abs(float(a) - float(b)) <= 1e-13, (a, b)


def boolean(value):
    if value is True or value == 'True':
        return True
    if value is False or value == 'False':
        return False
    raise AssertionError('Expected explicit boolean or canonical CSV boolean')


def digest_state(state):
    h = hashlib.sha256()
    for name in STATE_FIELDS:
        a = np.asarray(state[name])
        h.update(name.encode()); h.update(str(a.dtype).encode())
        h.update(str(a.shape).encode()); h.update(a.tobytes())
    return h.hexdigest()


def prefix_rows(small, full, observed):
    assert not any(row.get('reason') == 'encounter_end' for row in small)
    assert all('elapsed' in row for row in small + full)
    assert small == [row for row in full if row['elapsed'] <= observed + 1e-8]


