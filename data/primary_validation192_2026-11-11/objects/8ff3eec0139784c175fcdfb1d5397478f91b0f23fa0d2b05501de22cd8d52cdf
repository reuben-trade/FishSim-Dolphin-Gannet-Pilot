    def raw(self, case, *, smoke=False):
        duration = 4. if smoke else 36.
        phase = 'smoke' if smoke else self.c.case_phase(case)
        folder = self.c.phase_output(phase) / 'cases' / case.name
        self.e.validate_candidate_seal(folder, duration)
        initial = read(folder / 'initial_engine.json')
        config, summary = read(folder / 'config.json'), read(folder / 'summary.json')
        expected_roster = ([f'D{i:02d}' for i in range(12)] if case.dolphins else [])
        expected_roster += [f'G{i}' for i in range(case.gannets)]
        expected_roster.sort()
        assert [row['actor_id'] for row in initial['actors']] == expected_roster
        for field in ('actor_policy', 'capture_rng', 'controllers'):
            assert set(initial[field]) == set(expected_roster)
        assert set(summary['per_actor']) == set(expected_roster)
        assert config['actors'] == [dict(state=state,
            **initial['actor_policy'][state['actor_id']]) for state in initial['actors']]
        assert config['controller_initial_state'] == initial['controllers']
        assert read(folder / 'initial_shared.json') == {
            k: v for k, v in initial.items() if k != 'controllers'}
        engine_hash = hashlib.sha256(json.dumps(initial, sort_keys=True).encode()).hexdigest()
        assert engine_hash == self.zero_rows[case.name]['actual_engine_receipt_sha256']
        with np.load(folder / 'initial_school.npz', allow_pickle=False) as arrays:
            state = {name: arrays[name] for name in arrays.files}
            assert set(state) == set(STATE_FIELDS)
            assert digest_state(state) == self.zero_rows[case.name]['actual_fish_sha256']
        assert read(folder / 'source_manifest.json') == self.freeze['source_sha256']
        assert config['dt'] == case.dt and config['duration'] == duration
        for k, v in case.asdict().items():
            assert config[k] == v, (case.name, k)
        assert config['counts'] == dict(fish=160, D=12 if case.dolphins else 0, G=case.gannets)
        assert summary['planned_duration'] == duration and summary['dt'] == case.dt
        observed = summary['actual_duration']
        steps = summary['native_steps']
        assert 0 < observed <= duration + 1e-7 and steps == round(observed / case.dt)
        assert abs(observed - steps * case.dt) <= 1e-7
        events = records(folder / 'events.jsonl.gz')
        oral = [event for event in events if event['kind'] == 'oral' and event['closes_bout']]
        removed = [event['prey_id'] for event in oral if event['status'] == 'captured']
        assert len(removed) == len(set(removed)) == 160 - summary['final_count']
        if summary['native_absorbing_termination']:
            assert summary['final_count'] == 0 and len(removed) == 160
        else:
            assert abs(observed - duration) <= 1e-7
        output = dict(case.asdict(), actual_duration_T=observed, native_steps=steps,
                      native_absorbing_termination=summary['native_absorbing_termination'],
                      remaining_fish=summary['final_count'], initial_fish=160,
                      completion_sha256=sha(folder / 'completion.json'))
        for species in ('D', 'G'):
            who = [row for row in oral if row['actor_id'].startswith(species)]
            launches = [row for row in events if row['kind'] == 'transition'
                        and row['reason'] == 'launch' and row['actor_id'].startswith(species)]
            captures = sum(row['status'] == 'captured' for row in who)
            assert captures == summary['species'][species]['captures']
            assert len(who) == summary['species'][species]['contacts']
            assert len(launches) == summary['species'][species]['launches']
            output.update({species + '_captures': captures, species + '_contacts': len(who),
                           species + '_launches': len(launches)})
        return output, self.physical(folder)

    def phase(self, phase):
        smoke = phase == 'smoke'
        stage = 'smoke' if smoke else 'feeding'
        self.e.require_approval(stage)
        cells = self.c.phase_cases(phase)
        record = self.c.phase_record(phase)
        status, execution, physical = [read(record / name) for name in
                                      ('status.json', 'execution.json', 'physical_review.json')]
        assert status['status'] == execution['status'] == 'complete'
        assert status['phase'] == execution['phase'] == phase
        assert status['complete'] == status['planned'] == len(cells)
        assert len(status['cases']) == len(cells)
        indexed = {row['case']['case_name']: row for row in status['cases']}
        assert len(indexed) == len(cells) and set(indexed) == {case.name for case in cells}
        assert physical['status'] == 'passed'
        assert physical['status_sha256'] == sha(record / 'status.json')
        assert physical['review_source_sha256'] == PHYSICAL_SHA
        assert physical['wrapper_source_sha256'] == sha(HERE / 'review_phase.py')
        assert execution['freeze_sha256'] == FREEZE_SHA and execution['workers'] == 8
        assert execution['maximum_native_steps'] == self.c.phase_limit(phase)
        barriers = {}
        for wave, members in self.c.execution_stages(phase):
            barrier, dispatch = read(record / (wave + '_stage.json')), read(record / (wave + '_dispatch.json'))
            names = [case.name for case in members]
            assert barrier['status'] == 'complete' and barrier['cases'] == names
            assert dispatch['phase'] == phase and dispatch['wave'] == wave
            assert dispatch['case_names'] == names and dispatch['freeze_sha256'] == FREEZE_SHA
            barriers[wave] = dict(barrier_sha256=sha(record / (wave + '_stage.json')),
                                  dispatch_sha256=sha(record / (wave + '_dispatch.json')))
        rows, receipts = [], []
        for case in cells:
            row, receipt = self.raw(case, smoke=smoke)
            recorded = indexed[case.name]
            assert recorded['case'] == case.asdict()
            assert recorded['native_steps'] == row['native_steps']
            assert recorded['completion_sha256'] == row['completion_sha256']
            assert recorded['species'] == read(self.c.phase_output(phase) / 'cases' / case.name / 'summary.json')['species']
            rows.append(row); receipts.append(receipt)
        assert receipts == physical['cases']
        total = sum(row['native_steps'] for row in rows)
        assert total == status['total_native_steps'] == execution['total_native_steps'] == physical['native_steps']
        assert total <= self.c.phase_limit(phase)
        return dict(phase=phase, rows=rows, physical_cases=receipts, native_steps=total,
                    phase_limit=self.c.phase_limit(phase), phase_approval_sha256=sha(HERE / (stage.upper() + '_APPROVED.json')),
                    status_sha256=sha(record / 'status.json'), execution_sha256=sha(record / 'execution.json'),
                    physical_review_sha256=sha(record / 'physical_review.json'), control_barriers=barriers)

    def prefix(self, case):
        small = self.c.phase_output('smoke') / 'cases' / case.name
        full = self.c.phase_output(self.c.case_phase(case)) / 'cases' / case.name
        observed = read(small / 'summary.json')['actual_duration']
        for name in ('initial_engine.json', 'initial_shared.json'):
            assert read(small / name) == read(full / name)
        for name in ('initial_school.npz', 'trajectories.npz'):
            with np.load(small / name, allow_pickle=False) as a, np.load(full / name, allow_pickle=False) as b:
                assert set(a.files) == set(b.files)
                count = len(a['time']) if name == 'trajectories.npz' else None
                for key in a.files:
                    x, y = a[key], b[key]
                    if count is not None and key not in ('actor_ids', 'prey_ids'):
                        y = y[:count]
                    assert x.dtype == y.dtype and x.shape == y.shape and x.tobytes() == y.tobytes(), key
        for name in ('events.jsonl.gz', 'monitor.jsonl.gz', 'opportunities.jsonl.gz',
                     'bird_events.jsonl.gz', 'responses.jsonl.gz'):
            prefix_rows(records(small / name), records(full / name), observed)
        prefix_rows(read(small / 'school_metrics.json'), read(full / 'school_metrics.json'), observed)
        ties = read(small / 'tie_stream_calls.json')
        assert ties == read(full / 'tie_stream_calls.json')[:len(ties)]
        return dict(case=case.name, status='passed', prefix_T=observed,
                    smoke_completion_sha256=sha(small / 'completion.json'),
                    full_completion_sha256=sha(full / 'completion.json'))

