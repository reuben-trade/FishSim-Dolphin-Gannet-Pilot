    def audit(self, mode):
        if mode == 'smoke':
            phase = self.phase('smoke')
            result = dict(phase=phase, physical_review_sha256=phase['physical_review_sha256'],
                          interpretation='Engineering-only complete six cases; no feeding-benefit inference.')
        elif mode.startswith('block'):
            number = int(mode[5:]); assert 1 <= number <= 4
            phases = {grid: self.phase(f'block{number}_{grid}') for grid in ('coarse', 'fine')}
            result = dict(phases=phases, completed_full_cases=48, independent_schools=4,
                          interpretation='Complete prespecified paired block only; descriptive raw counts, no confirmatory decision or reselection.')
            if number == 1:
                result['prefixes'] = [self.prefix(case) for case in self.c.smoke_cases()]
        elif mode == 'final':
            result = self.final()
        else:
            raise ValueError('Unknown independent audit mode')
        self.e.verify_source_freeze()
        assert 'fish_sim.cmodel' not in sys.modules
        result.update(status='passed', stage=mode, at=datetime.now(timezone.utc).isoformat(),
                      bindings=self.bindings, freeze_sha256=FREEZE_SHA,
                      audit_source_sha256=sha(__file__), native_constructions_by_review=0,
                      native_steps_by_review=0)
        return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--phase', choices=('smoke', 'block1', 'block2', 'block3', 'block4', 'final'), required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    assert not args.output.exists(), 'Never overwrite a review receipt'
    result = Context().audit(args.phase)
    with args.output.open('x') as handle:
        handle.write(json.dumps(result, indent=2, allow_nan=False) + '\n')
    print(json.dumps(dict(status='passed', receipt=str(args.output), sha256=sha(args.output), native_steps_by_review=0)))


if __name__ == '__main__':
    main()
