def read(path): return json.loads(Path(path).read_text())
def sha(path): return hashlib.sha256(Path(path).read_bytes()).hexdigest()
def require(condition,message):
    if not condition: raise ValueError(message)
def integer(value):
    require(not isinstance(value,bool),'Boolean cannot substitute for integer metadata')
    result=Decimal(str(value))
    require(result.is_finite() and result==result.to_integral_value(),'Nonintegral metadata')
    return int(result)
def flag(value):
    if type(value) is bool:return value
    require(value in ('True','False'),'Noncanonical CSV boolean')
    return value=='True'
def number(value):
    require(not isinstance(value,bool),'Boolean cannot substitute for numeric metadata')
    result=float(value);require(math.isfinite(result),'Nonfinite metadata');return result
def name(school,label,grid,arm):
    policy='Gonly36' if arm=='G' else 'H1_G36' if arm=='DG' else 'H1_G0'
    return f's{school}_{grid}_{policy}_{arm}_c{label}'

def validate_final_review(review):
    require(review.get('status')=='passed' and review.get('stage')=='final','Original independent FINAL acceptance required')
    require(review.get('new_full_cases')==192 and review.get('independent_schools')==16,'All192/n16 required')
    require(review.get('reused_discovery_cases_in_estimate')==0,'No discovery pooling')
    require(review.get('freeze_sha256')==FREEZE_SHA and review.get('bindings',{}).get('execution_freeze_sha256')==FREEZE_SHA,'Wrong execution freeze')
    require(review.get('audit_source_sha256')==AUDITOR_SHA,'Original independent8ff auditor required')
    require(review.get('native_constructions_by_review')==review.get('native_steps_by_review')==0,'Independent read-only review required')
    digest=review.get('analysis_audit_sha256','')
    require(len(digest)==64 and all(c in '0123456789abcdef' for c in digest),'Independent FINAL must bind owner analysis')
    # Scientific criterion/sign is deliberately not consulted or replaced.

def normalise_csv(rows):
    expected={name(s,l,g,a) for s in SCHOOLS for l in LABELS for g in GRIDS for a in ARMS}
    index={}
    for row in rows:
        s,l=integer(row['school_seed']),integer(row['replicate_label'])
        g,a=row['grid'],row['presence'];require(s in SCHOOLS and l in LABELS and g in GRIDS and a in ARMS,'Unexpected design cell')
        identity=name(s,l,g,a)
        require(row['case_name']==row['case_id']==identity and identity not in index,'Duplicate/foreign case identity')
        require(integer(row['capture_seed'])==integer(row['capture_label'])==l,'Unmatched world labels')
        nd,ng=(12 if 'D' in a else 0),(36 if 'G' in a else 0)
        require(integer(row['dolphins'])==nd and integer(row['gannets'])==ng and integer(row['initial_fish'])==160,'Wrong predator/prey metadata')
        require(number(row['dt'])==GRIDS[g] and number(row['duration_T'])==36,'Wrong nominal clock/grid')
        dc,gc,remaining=map(integer,(row['D_captures'],row['G_captures'],row['remaining_fish']))
        require(min(dc,gc,remaining)>=0 and dc+gc+remaining==160,'Unique-prey accounting differs')
        require((nd or dc==0) and (ng or gc==0),'Absent species has food')
        observed,steps,absorbed=number(row['actual_duration_T']),integer(row['native_steps']),flag(row['native_absorbing_termination'])
        require(0<observed<=36+CLOCK_TOL and steps>0 and steps==round(observed/GRIDS[g]) and abs(observed-steps*GRIDS[g])<=CLOCK_TOL,'Incoherent observed clock')
        require((remaining==0 and dc+gc==160) if absorbed else (abs(observed-36)<=CLOCK_TOL and steps==round(36/GRIDS[g])),'Incomplete horizon or incoherent depletion')
        index[identity]=dict(case_id=identity,school_seed=s,replicate_label=l,grid=g,dt=GRIDS[g],presence=a,
            dolphins=nd,gannets=ng,D_captures=dc,G_captures=gc,duration_T=36,
            actual_duration_T=observed,native_steps=steps,native_absorbing_termination=absorbed,remaining_fish=remaining)
    require(len(rows)==len(index)==192 and set(index)==expected,'Complete192 unique cases required')
    return index

def validate_metadata(statistics,rows):
    index=normalise_csv(rows);design=statistics['design']
    require(design['schools']==list(SCHOOLS) and design['replicate_labels']==list(LABELS),'Wrong saved school/label inventory')
    require(design['grids']==GRIDS and design['presence_arms']==list(ARMS),'Wrong saved grid/arm inventory')
    for field,expected in (('dolphins',12),('gannets',36),('fish',160),('duration_T',36)):
        require(type(design[field]) in (int,float) and design[field]==expected,'Wrong numeric design: '+field)
    require(statistics['case_count']==192,'Wrong saved case count')
    points=statistics['case_points'];saved={r['case_id']:r for r in points}
    require(len(points)==len(saved)==192 and set(saved)==set(index),'Saved casepoint inventory differs')
    for identity,point in saved.items():
        raw=index[identity];require(set(point)==POINT_FIELDS,'Canonical primary casepoint fields differ')
        for field in ('case_id','school_seed','replicate_label','grid','dt','presence','dolphins','gannets','D_captures','G_captures','duration_T','native_steps','remaining_fish'):
            require(point[field]==raw[field],'Casepoint differs from accepted raw CSV: '+field)
        for field in ('school_seed','replicate_label','dolphins','gannets','D_captures','G_captures','native_steps','remaining_fish'):
            require(type(point[field]) is int,'Casepoint integer type differs: '+field)
        require(type(point['duration_T']) in (int,float),'Invalid nominal clock type')
        require(type(point['native_absorbing_termination']) is bool and point['native_absorbing_termination']==raw['native_absorbing_termination'],'Casepoint absorbing flag differs')
        actual=number(point['actual_duration_T'])
        require(0<actual<=36+CLOCK_TOL and abs(actual-raw['actual_duration_T'])<=CLOCK_TOL and abs(actual-point['native_steps']*point['dt'])<=CLOCK_TOL,'Casepoint observed clock differs')
        for species,count in (('D',raw['dolphins']),('G',raw['gannets'])):
            for key,denominator in (('captures_per_individual_36T',count),('captures_per_individual_per_T',count*36)):
                value=point[species+'_'+key]
                if count:require(abs(number(value)-raw[species+'_captures']/denominator)<=1e-13,'Casepoint food/rate normalization differs')
                else:require(value is None,'Absent-species food must remain null')
    return index

def audit(final_review_path):
    require(not sys.flags.optimize,'Unoptimized Python required')
    require(sha(AUDITOR)==AUDITOR_SHA and sha(REGISTRY)==REGISTRY_SHA,'Original auditor/registry changed')
    require(sha(HERE/'frozen_sources.json')==FREEZE_SHA and sha(HERE/'protocol.json')==PROTOCOL_SHA,'Frozen primary source changed')
    require(sha(HERE/'validation_statistics.py')==STATISTICS_SOURCE_SHA,'Original primary statistics source changed')
    review=read(final_review_path);validate_final_review(review)
    output=BULK/'analysis_final';analysis=output/'analysis_audit.json'
    require(sha(analysis)==review['analysis_audit_sha256'],'Owner analysis differs from independent FINAL')
    owner=read(analysis)
    require(owner['status']=='passed' and owner['full_cases']==192 and owner['independent_schools']==16 and owner['replicate_labels']==2 and owner['primary_grid']=='fine','Wrong original primary final schema')
    require(owner['source_freeze_sha256']==FREEZE_SHA and owner['protocol_sha256']==PROTOCOL_SHA and owner['native_steps_executed_by_analysis']==0,'Wrong analysis provenance')
    for file in ('statistics.json','case_outcomes.csv'):
        require(sha(output/file)==owner['files'][file],'Accepted export changed: '+file)
    with (output/'case_outcomes.csv').open(newline='') as handle:rows=list(csv.DictReader(handle))
    index=validate_metadata(read(output/'statistics.json'),rows)
    phases=review['phases'];expected_phases={'smoke',*(f'block{i}_{g}' for i in range(1,5) for g in GRIDS)}
    require(set(phases)==expected_phases,'Original FINAL must cover all eight feeding phases plus engineering')
    accepted=[r for phase in expected_phases-{'smoke'} for r in phases[phase]['rows']]
    raw={r['case_name']:r for r in accepted};require(len(accepted)==len(raw)==192 and set(raw)==set(index),'Independent raw192 inventory differs')
    csv_by_name={r['case_name']:r for r in rows}
    require(set(owner['case_completion_sha256'])==set(index),'Owner seal inventory differs')
    for identity,point in index.items():
        folder=BULK/'full_36T_v1/cases'/identity
        seal=folder/'completion.json';expected=raw[identity]['completion_sha256']
        require(sha(seal)==expected==owner['case_completion_sha256'][identity]==csv_by_name[identity]['completion_sha256'],'Case seal binding differs')
        completed=read(seal);require(completed['status']=='complete','Case incomplete')
        for file in ('config.json','summary.json'):require(sha(folder/file)==completed['files'][file],'Sealed raw metadata changed')
        config,summary=read(folder/'config.json'),read(folder/'summary.json')
        for field in ('case_id','school_seed','replicate_label','grid','dt','presence','dolphins','gannets'):
            require(config[field]==point[field] and raw[identity][field]==point[field],'Raw case identity differs: '+field)
        require(config['duration']==summary['planned_duration']==36 and summary['dt']==point['dt'],'Raw nominal horizon differs')
        require(type(summary['native_absorbing_termination']) is bool and summary['native_absorbing_termination']==point['native_absorbing_termination'],'Raw depletion flag differs')
        require(type(summary['native_steps']) is int and type(summary['final_count']) is int,'Raw steps/removals must be integers')
        require(summary['native_steps']==point['native_steps'] and summary['final_count']==point['remaining_fish'],'Raw steps/removal count differs')
        require(abs(number(summary['actual_duration'])-point['actual_duration_T'])<=CLOCK_TOL,'Raw observed clock differs')
        require(raw[identity]['native_steps']==point['native_steps'] and raw[identity]['remaining_fish']==point['remaining_fish'],'Independent accepted raw steps/removals differ')
        require(type(raw[identity]['native_absorbing_termination']) is bool and raw[identity]['native_absorbing_termination']==point['native_absorbing_termination'],'Independent accepted raw depletion flag differs')
        require(abs(number(raw[identity]['actual_duration_T'])-point['actual_duration_T'])<=CLOCK_TOL,'Independent accepted raw observed clock differs')
        for species in ('D','G'):
            require(type(summary['species'][species]['captures']) is int,'Raw captures must be integers')
            require(summary['species'][species]['captures']==raw[identity][species+'_captures']==point[species+'_captures'],'Raw captures differ')
    return dict(status='passed',schema='fishsim_primary_final_metadata_supplement_v1',stage='final_publication_metadata_supplement',
        original_final_review_sha256=sha(final_review_path),original_auditor_sha256=AUDITOR_SHA,execution_freeze_sha256=FREEZE_SHA,
        analysis_audit_sha256=sha(analysis),statistics_sha256=sha(output/'statistics.json'),case_csv_sha256=sha(output/'case_outcomes.csv'),
        cases=192,independent_school_clusters=16,clock_tolerance_T=CLOCK_TOL,
        original_final_receipt_mandatory=True,original_final_receipt_replaced=False,
        scientific_effects_intervals_or_decision_recomputed=False,scientific_success_required=False,
        native_imports=0,native_constructions=0,native_steps=0,native_leases=0)

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--final-review',type=Path,required=True);parser.add_argument('--output',type=Path,required=True)
    args=parser.parse_args();require(not args.output.exists(),'Never overwrite a supplement receipt')
    result=audit(args.final_review)
    result.update(at=datetime.now(timezone.utc).isoformat(),sidecar_source_sha256=sha(__file__))
    with args.output.open('x') as handle:handle.write(json.dumps(result,indent=2,allow_nan=False)+'\n')
    print(json.dumps(dict(status='passed',receipt=str(args.output),sha256=sha(args.output))))

if __name__=='__main__':main()
