"""Create source/input freezes only; never approval or native execution."""
import argparse
from common import HERE,read,sha,write,stamp
from evidence import (base_sources,verify_selection,verify_preparation_freeze,
    feeding_sources,verify_feeding_inputs)


def create(phase):
    verify_selection(deep=True)
    if phase=='preparation':
        pure=read(HERE/'PURE_PREFLIGHT.json')
        if pure.get('status')!='passed' or pure['native_steps'] or pure['native_constructions']:
            raise RuntimeError('Passed native-free raw sampler/source preflight required')
        name='PREPARATION_FREEZE.json'
        record=dict(status='frozen_before_preparation_native',at=stamp(),
            source_sha256=base_sources(),pure_preflight_sha256=sha(HERE/'PURE_PREFLIGHT.json'),native_steps=0)
    elif phase=='feeding-inputs':
        verify_preparation_freeze();name='FEEDING_INPUT_FREEZE.json'
        record=dict(status='frozen_before_actual_initialization',at=stamp(),
            source_sha256=feeding_sources(),preparation_freeze_sha256=sha(HERE/'PREPARATION_FREEZE.json'),native_steps=0)
    elif phase=='feeding':
        inputs=verify_feeding_inputs();zero=read(HERE/'ACTUAL_ZERO_STEP.json')
        if (zero.get('status')!='passed' or zero['native_steps']!=0 or zero['actual_cases']!=64
                or zero.get('feeding_input_freeze_sha256')!=sha(HERE/'FEEDING_INPUT_FREEZE.json')):
            raise RuntimeError('All64 primary/repeat actual initial-state matches required')
        name='FEEDING_FREEZE.json'
        record=dict(status='frozen_after_actual_initialization_before_feeding',at=stamp(),
            source_sha256=inputs['source_sha256'],feeding_input_freeze_sha256=sha(HERE/'FEEDING_INPUT_FREEZE.json'),
            actual_zero_step_sha256=sha(HERE/'ACTUAL_ZERO_STEP.json'),native_steps=0)
    else:raise ValueError('Unknown freeze phase')
    if (HERE/name).exists():raise RuntimeError('Refuse freeze overwrite')
    write(HERE/name,record);return name


if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--phase',required=True,choices=('preparation','feeding-inputs','feeding'))
    print(create(parser.parse_args().phase))
