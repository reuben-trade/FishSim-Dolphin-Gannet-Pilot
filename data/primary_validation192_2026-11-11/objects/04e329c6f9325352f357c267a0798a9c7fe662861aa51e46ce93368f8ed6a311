def test_matching_controls_changes_world_noise_without_inventing_schools(balanced):
    rows, original = balanced
    changed = deepcopy(rows)
    for row in changed:
        if row["school_seed"] == stats.SCHOOL_SEEDS[0] and row["grid"] == "fine" and row["presence"] == "D":
            shift = 6 if row["replicate_label"] == 71001 else -6
            row["D_captures"] += shift
            row["D_contacts"] += shift
            row["D_launches"] += shift
            row["remaining_fish"] -= shift
    result = stats.analyse(changed)
    a, b = original["primary"]["species"]["D"], result["primary"]["species"]["D"]
    assert a["mean"] == b["mean"] and a["school_sd"] == b["school_sd"]
    assert b["within_school_variance_W"] > a["within_school_variance_W"]
    assert b["n_schools"] == 16


@pytest.mark.parametrize("arm", ["D", "G", "DG"])
def test_duplicate_controls_or_mixed_rows_are_never_replications(arm):
    rows = completed_rows()
    duplicate = deepcopy(next(r for r in rows if r["presence"] == arm))
    duplicate["case_name"] += "_replay"
    with pytest.raises(ValueError, match="Duplicate design cell"):
        stats.analyse(rows + [duplicate])


def test_missing_and_early_blocks_have_no_final_decision():
    rows = completed_rows()
    with pytest.raises(ValueError, match="missing1|missing 1"):
        stats.analyse(rows[:-1])
    # The first four-school block has48 cases, not sixteen independent schools.
    with pytest.raises(ValueError, match="No zero imputation or early decision"):
        stats.analyse(rows[:48])


def _declare_depleted(row):
    row.update({"D_captures": 160, "G_captures": 0, "remaining_fish": 0,
                "D_contacts": 160, "D_launches": 162, "actual_duration_T": 8. - 3e-11,
                "native_steps": 6400, "native_absorbing_termination": True})


def test_declared_absorbing_depletion_keeps_nominal36T_denominators():
    rows = completed_rows()
    _declare_depleted(rows[0])  # coarse, first school/label, D-only
    result = stats.analyse(rows)
    case = next(r for r in result["case_points"] if r["case_id"] == rows[0]["case_name"])
    world = next(r for r in result["world_points"] if r["school_seed"] == rows[0]["school_seed"]
                 and r["replicate_label"] == 71001 and r["grid"] == "coarse")
    assert case["native_absorbing_termination"] is True
    assert case["D_captures_per_individual_36T"] == pytest.approx(160 / 12)
    assert case["D_captures_per_individual_per_T"] == pytest.approx(160 / (12 * 36))
    assert world["D_effect_per_individual_36T"] == pytest.approx((34 - 160) / 12)
    assert world["D_rate_change_per_individual_per_T"] == pytest.approx((34 - 160) / (12 * 36))
    # CSV truth values must preserve the same coherent absorption declaration.
    rows[0]["native_absorbing_termination"] = "True"
    assert stats.analyse(rows) == result


@pytest.mark.parametrize("change", [
    {"native_absorbing_termination": False},  # depleted counts alone do not declare a valid early stop
    {"actual_duration_T": 0},
    {"actual_duration_T": 37},
    {"actual_duration_T": 8.0002},  # wrong clock even though rounding gives6400 steps
    {"native_steps": 6399},
    {"D_captures": 159, "remaining_fish": 1},
])
def test_early_or_incoherent_depletion_is_rejected(change):
    rows = completed_rows()
    _declare_depleted(rows[0])
    rows[0].update(change)
    with pytest.raises(ValueError, match="complete36T|depletion"):
        stats.analyse(rows)


@pytest.mark.parametrize("field", ["native_absorbing_termination", "actual_duration_T", "native_steps", "remaining_fish"])
def test_depletion_without_explicit_required_evidence_is_rejected(field):
    rows = completed_rows()
    _declare_depleted(rows[0])
    del rows[0][field]
    with pytest.raises(ValueError, match="complete36T|depletion"):
        stats.analyse(rows)


