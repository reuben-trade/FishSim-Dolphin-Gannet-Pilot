    assert group["n_worlds"] == 32 and group["n_schools"] == 16
    assert group["D_mean_captures_per_individual_36T"] == pytest.approx(group["D_group_total_captures"] / (32 * 12))
    assert group["G_mean_captures_per_individual_36T"] == pytest.approx(group["G_group_total_captures"] / (32 * 36))
